{
  "name": "generative-ui-mcp-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run build && concurrently --kill-others -n ui,server,host \"bun run --cwd apps/ui watch\" \"bun run --cwd apps/server dev\" \"bun run --cwd apps/host serve\"",
    "start": "concurrently --kill-others -n server,host \"bun run --cwd apps/server start\" \"bun run --cwd apps/host serve\"",
    "build": "bun run --cwd apps/ui build && bun run --cwd apps/host build && bun run slides:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/host",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "checkpoint": "node scripts/checkpoint.mjs",
    "slides": "bun run --cwd apps/slides dev",
    "slides:build": "bun run --cwd apps/slides build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@shadcn/lint": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plugin-singlefile": "2.3.3",
    "vite-plus": "0.3.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  }
}
